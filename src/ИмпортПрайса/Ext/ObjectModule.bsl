#Область ПрограммныйИнтерфейс

// Вызов из серверного контекста возвращает число проверенных условий.
// При нарушении любого условия выполнение завершается исключением.
Функция ВыполнитьСамопроверку() Экспорт
    Разбор = РазобратьЦену("123,45");
    ПроверитьУсловие(Разбор.Цена = 123.45, "Десятичная запятая");
    Разбор = РазобратьЦену(" 12.5 ");
    ПроверитьУсловие(Разбор.Цена = 12.5, "Точка и пробелы по краям");
    Разбор = РазобратьЦену("0");
    ПроверитьУсловие(Не Разбор.Успех, "Нулевая цена");
    Разбор = РазобратьЦену("-1");
    ПроверитьУсловие(Не Разбор.Успех, "Отрицательная цена");
    Разбор = РазобратьЦену("1,234");
    ПроверитьУсловие(Не Разбор.Успех, "Избыточная точность");
    Разбор = РазобратьЦену("1e3");
    ПроверитьУсловие(Не Разбор.Успех, "Экспонента");
    Разбор = РазобратьЦену("1.");
    ПроверитьУсловие(Не Разбор.Успех, "Незавершенная дробь");
    Разбор = РазобратьЦену("");
    ПроверитьУсловие(Не Разбор.Успех, "Пустая цена");

    Прайс = НоваяТаблицаПрайса();
    ДобавитьТестовуюСтроку(Прайс, "001", "Товар 1", "10");
    ДобавитьТестовуюСтроку(Прайс, "002", "Товар 2", "20");
    ДобавитьТестовуюСтроку(Прайс, "003", "Товар 3", "30");
    ДобавитьТестовуюСтроку(Прайс, "004", "Дубль 1", "40");
    ДобавитьТестовуюСтроку(Прайс, "004", "Дубль 2", "41");
    ДобавитьТестовуюСтроку(Прайс, "005", "", "50");
    ДобавитьТестовуюСтроку(Прайс, "006", "Ошибка цены", "текст");
    Связи = НоваяТаблицаСопоставлений();
    ДобавитьТестовуюСвязь(Связи, "001", "N1");
    ДобавитьТестовуюСвязь(Связи, "001", "N1");
    ДобавитьТестовуюСвязь(Связи, "003", "N3");
    ДобавитьТестовуюСвязь(Связи, "003", "N4");
    Проверка = ПроверитьПрайс(Прайс, Связи);
    Итог = Проверка.Строки;
    ПроверитьУсловие(Итог.Количество() = 7, "Сохранены все строки");
    ПроверитьУсловие(Итог[0].Статус = "Найдена" И Итог[0].КодНоменклатуры = "N1", "Точное сопоставление");
    ПроверитьУсловие(Итог[1].Статус = "Новая", "Нет соответствия");
    ПроверитьУсловие(Итог[2].Статус = "Ошибка", "Неоднозначность");
    ПроверитьУсловие(Итог[3].Статус = "Ошибка" И Итог[4].Статус = "Ошибка", "Оба дубля отклонены");
    ПроверитьУсловие(Итог[5].Статус = "Ошибка", "Пустое наименование");
    ПроверитьУсловие(Итог[6].Статус = "Ошибка", "Неверная цена");
    Проверка = ПроверитьПрайс(НоваяТаблицаПрайса(), Связи);
    ПроверитьУсловие(Проверка.Строки.Количество() = 0, "Пустой файл");
    Возврат 16;
КонецФункции

// Серверный вызов. Путь должен указывать на уже загруженный файл на сервере.
// Колонки первого листа: Артикул, Наименование, Цена. Первая строка - заголовки.
Функция ПрочитатьПрайс(ПутьКФайлу) Экспорт
    Документ = Новый ТабличныйДокумент;
    Документ.Прочитать(ПутьКФайлу);
    Если Документ.ВысотаТаблицы < 1 Или Документ.ШиринаТаблицы < 3 Тогда
        ВызватьИсключение "Ожидаются колонки Артикул, Наименование, Цена.";
    КонецЕсли;
    Если СокрЛП(Документ.Область(1, 1).Текст) <> "Артикул"
        Или СокрЛП(Документ.Область(1, 2).Текст) <> "Наименование"
        Или СокрЛП(Документ.Область(1, 3).Текст) <> "Цена" Тогда
        ВызватьИсключение "Неверные заголовки прайс-листа.";
    КонецЕсли;
    Строки = НоваяТаблицаПрайса();
    Для НомерСтроки = 2 По Документ.ВысотаТаблицы Цикл
        Артикул = СокрЛП(Документ.Область(НомерСтроки, 1).Текст);
        Наименование = СокрЛП(Документ.Область(НомерСтроки, 2).Текст);
        ЦенаТекст = СокрЛП(Документ.Область(НомерСтроки, 3).Текст);
        Если ПустаяСтрока(Артикул) И ПустаяСтрока(Наименование) И ПустаяСтрока(ЦенаТекст) Тогда
            Продолжить;
        КонецЕсли;
        СтрокаПрайса = Строки.Добавить();
        СтрокаПрайса.НомерСтроки = НомерСтроки;
        СтрокаПрайса.Артикул = Артикул;
        СтрокаПрайса.Наименование = Наименование;
        СтрокаПрайса.ЦенаТекст = ЦенаТекст;
    КонецЦикла;
    Возврат Строки;
КонецФункции

// Сопоставления заранее отбираются адаптером по ОДНОМУ поставщику.
// Таблица: Артикул (строка), КодНоменклатуры (строка).
// Код - идентификатор для демонстрации; в конфигурационном адаптере используют ссылку.
Функция ПроверитьПрайс(Строки, Сопоставления) Экспорт
    Начало = ТекущаяДата();
    Результат = Новый ТаблицаЗначений;
    Результат.Колонки.Добавить("НомерСтроки");
    Результат.Колонки.Добавить("Артикул");
    Результат.Колонки.Добавить("Наименование");
    Результат.Колонки.Добавить("Цена");
    Результат.Колонки.Добавить("КодНоменклатуры");
    Результат.Колонки.Добавить("Статус");
    Результат.Колонки.Добавить("Сообщение");

    Индекс = ПостроитьИндекс(Сопоставления);
    Количества = Новый Соответствие;
    Для Каждого СтрокаПрайса Из Строки Цикл
        Ключ = СокрЛП(СтрокаПрайса.Артикул);
        Количество = Количества.Получить(Ключ);
        Если Количество = Неопределено Тогда
            Количество = 0;
        КонецЕсли;
        Количества.Вставить(Ключ, Количество + 1);
    КонецЦикла;

    Для Каждого СтрокаПрайса Из Строки Цикл
        СтрокаРезультата = Результат.Добавить();
        СтрокаРезультата.НомерСтроки = СтрокаПрайса.НомерСтроки;
        СтрокаРезультата.Артикул = СокрЛП(СтрокаПрайса.Артикул);
        СтрокаРезультата.Наименование = СокрЛП(СтрокаПрайса.Наименование);
        СтрокаРезультата.Статус = "Ошибка";
        Если ПустаяСтрока(СтрокаРезультата.Артикул) Или ПустаяСтрока(СтрокаРезультата.Наименование) Тогда
            СтрокаРезультата.Сообщение = "Не заполнен артикул или наименование.";
            Продолжить;
        КонецЕсли;
        Если Количества.Получить(СтрокаРезультата.Артикул) > 1 Тогда
            СтрокаРезультата.Сообщение = "Артикул повторяется в файле. Исправьте все повторяющиеся строки.";
            Продолжить;
        КонецЕсли;
        Разбор = РазобратьЦену(СтрокаПрайса.ЦенаТекст);
        Если Не Разбор.Успех Тогда
            СтрокаРезультата.Сообщение = Разбор.Ошибка;
            Продолжить;
        КонецЕсли;
        СтрокаРезультата.Цена = Разбор.Цена;
        Кандидаты = Индекс.Получить(СтрокаРезультата.Артикул);
        Если Кандидаты = Неопределено Тогда
            СтрокаРезультата.Статус = "Новая";
            СтрокаРезультата.Сообщение = "Соответствие не найдено. Нужна проверка перед созданием карточки.";
        ИначеЕсли Кандидаты.Количество() <> 1 Тогда
            СтрокаРезультата.Сообщение = "Найдено несколько соответствий номенклатуры.";
        Иначе
            СтрокаРезультата.КодНоменклатуры = Кандидаты[0];
            СтрокаРезультата.Статус = "Найдена";
            СтрокаРезультата.Сообщение = "Проверка пройдена. Данные в базу не записаны.";
        КонецЕсли;
    КонецЦикла;
    Возврат Новый Структура("Строки,ДлительностьСекунд", Результат, ТекущаяДата() - Начало);
КонецФункции

Функция НоваяТаблицаПрайса() Экспорт
    Таблица = Новый ТаблицаЗначений;
    Таблица.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
    Таблица.Колонки.Добавить("Артикул", Новый ОписаниеТипов("Строка"));
    Таблица.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка"));
    Таблица.Колонки.Добавить("ЦенаТекст", Новый ОписаниеТипов("Строка"));
    Возврат Таблица;
КонецФункции

Функция НоваяТаблицаСопоставлений() Экспорт
    Таблица = Новый ТаблицаЗначений;
    Таблица.Колонки.Добавить("Артикул", Новый ОписаниеТипов("Строка"));
    Таблица.Колонки.Добавить("КодНоменклатуры", Новый ОписаниеТипов("Строка"));
    Возврат Таблица;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьУсловие(Условие, Название)
    Если Не Условие Тогда
        ВызватьИсключение "Самопроверка: " + Название;
    КонецЕсли;
КонецПроцедуры

Процедура ДобавитьТестовуюСтроку(Таблица, Артикул, Наименование, Цена)
    НоваяСтрока = Таблица.Добавить();
    НоваяСтрока.НомерСтроки = Таблица.Количество() + 1;
    НоваяСтрока.Артикул = Артикул;
    НоваяСтрока.Наименование = Наименование;
    НоваяСтрока.ЦенаТекст = Цена;
КонецПроцедуры

Процедура ДобавитьТестовуюСвязь(Таблица, Артикул, Код)
    НоваяСтрока = Таблица.Добавить();
    НоваяСтрока.Артикул = Артикул;
    НоваяСтрока.КодНоменклатуры = Код;
КонецПроцедуры

Функция ПостроитьИндекс(Сопоставления)
    Индекс = Новый Соответствие;
    Для Каждого СтрокаСвязи Из Сопоставления Цикл
        Ключ = СокрЛП(СтрокаСвязи.Артикул);
        Код = СокрЛП(СтрокаСвязи.КодНоменклатуры);
        Если ПустаяСтрока(Ключ) Или ПустаяСтрока(Код) Тогда
            ВызватьИсключение "Адаптер передал пустой артикул или код номенклатуры.";
        КонецЕсли;
        Кандидаты = Индекс.Получить(Ключ);
        Если Кандидаты = Неопределено Тогда
            Кандидаты = Новый Массив;
            Индекс.Вставить(Ключ, Кандидаты);
        КонецЕсли;
        Если Кандидаты.Найти(Код) = Неопределено Тогда
            Кандидаты.Добавить(Код);
        КонецЕсли;
    КонецЦикла;
    Возврат Индекс;
КонецФункции

// Строгий формат: положительное число, до 12 цифр целой части и 2 дробных.
// Разделитель - точка или запятая. Без валюты, экспоненты и разделителей тысяч.
// Ручное накопление цифр устраняет зависимость преобразования от локали.
Функция РазобратьЦену(ИсходныйТекст)
    Текст = СокрЛП(ИсходныйТекст);
    Ответ = Новый Структура("Успех,Цена,Ошибка", Ложь, 0,
        "Цена должна быть положительным числом: до 12 цифр до разделителя и 2 после.");
    Если ПустаяСтрока(Текст) Тогда
        Возврат Ответ;
    КонецЕсли;
    Цена = 0;
    ЦелыхЦифр = 0;
    ДробныхЦифр = 0;
    ЕстьРазделитель = Ложь;
    Для Позиция = 1 По СтрДлина(Текст) Цикл
        Символ = Сред(Текст, Позиция, 1);
        Если Символ = "." Или Символ = "," Тогда
            Если ЕстьРазделитель Или ЦелыхЦифр = 0 Тогда
                Возврат Ответ;
            КонецЕсли;
            ЕстьРазделитель = Истина;
            Продолжить;
        КонецЕсли;
        Цифра = Найти("0123456789", Символ) - 1;
        Если Цифра < 0 Тогда
            Возврат Ответ;
        КонецЕсли;
        Если ЕстьРазделитель Тогда
            ДробныхЦифр = ДробныхЦифр + 1;
        Иначе
            ЦелыхЦифр = ЦелыхЦифр + 1;
        КонецЕсли;
        Если ЦелыхЦифр > 12 Или ДробныхЦифр > 2 Тогда
            Возврат Ответ;
        КонецЕсли;
        Цена = Цена * 10 + Цифра;
    КонецЦикла;
    Если Цена = 0 Или (ЕстьРазделитель И ДробныхЦифр = 0) Тогда
        Возврат Ответ;
    КонецЕсли;
    Если ДробныхЦифр = 1 Тогда
        Цена = Цена / 10;
    ИначеЕсли ДробныхЦифр = 2 Тогда
        Цена = Цена / 100;
    КонецЕсли;
    Ответ.Успех = Истина;
    Ответ.Цена = Цена;
    Ответ.Ошибка = "";
    Возврат Ответ;
КонецФункции

#КонецОбласти
